      </tr>
      <tr>
        <td>Classification prompt v1</td>
        <td>Duty mapping + blend logic + explanation template</td>
        <td><span class="tag tag-done">Done</span></td>
      </tr>
      <tr>
        <td>Project spec (v3)</td>
        <td>Full architecture, schema, deliverables checklist</td>
        <td><span class="tag tag-done">Done</span></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- ============================================================ -->
<!-- 4. CURRENT PIPELINE -->
<!-- ============================================================ -->
<div class="section" id="pipeline">
  <div class="section-header">
    <div class="section-number">4</div>
    <h2>Current Pipeline (What Exists Today)</h2>
  </div>

  <p style="margin-bottom:1rem; font-size:0.92rem; color:var(--gray-700)">
    The current system is a <strong>prompt-based pipeline</strong>: scrape DHRM reference data, structure it into tables, and provide it as context to an LLM along with a position description. The LLM does all the classification reasoning.
  </p>

  <div class="diagram-container">
    <h4>Figure 1: Current Architecture (Prompt-Based)</h4>
    <svg viewBox="0 0 880 420" xmlns="http://www.w3.org/2000/svg" font-family="Segoe UI, system-ui, sans-serif">
      <!-- Background -->
      <rect width="880" height="420" fill="#f7fafc" rx="8"/>

      <!-- Title -->
      <text x="440" y="30" text-anchor="middle" font-size="14" font-weight="700" fill="#2d3748">CURRENT PIPELINE: Prompt-Based Classification</text>

      <!-- === LAYER 1: Data Sources === -->
      <rect x="20" y="50" width="840" height="90" rx="6" fill="#ebf4ff" stroke="#3182ce" stroke-width="1" stroke-dasharray="4"/>
      <text x="40" y="70" font-size="11" font-weight="700" fill="#2a4365">LAYER 1: Data Sources</text>

      <!-- DHRM HTML -->
      <rect x="40" y="80" width="120" height="48" rx="4" fill="#3182ce" stroke="none"/>
      <text x="100" y="100" text-anchor="middle" font-size="11" font-weight="600" fill="white">DHRM HTML</text>
      <text x="100" y="116" text-anchor="middle" font-size="9" fill="#bee3f8">50 pages</text>

      <!-- DHRM PDF -->
      <rect x="180" y="80" width="120" height="48" rx="4" fill="#3182ce" stroke="none"/>
      <text x="240" y="100" text-anchor="middle" font-size="11" font-weight="600" fill="white">DHRM PDF</text>
      <text x="240" y="116" text-anchor="middle" font-size="9" fill="#bee3f8">6 pages (3 variants)</text>

      <!-- FY26 Salary PDF -->
      <rect x="320" y="80" width="120" height="48" rx="4" fill="#3182ce" stroke="none"/>
      <text x="380" y="100" text-anchor="middle" font-size="11" font-weight="600" fill="white">FY26 Salary PDF</text>
      <text x="380" y="116" text-anchor="middle" font-size="9" fill="#bee3f8">9 pay bands</text>

      <!-- W&M Grades -->
      <rect x="460" y="80" width="120" height="48" rx="4" fill="#3182ce" stroke="none"/>
      <text x="520" y="100" text-anchor="middle" font-size="11" font-weight="600" fill="white">W&M Salary</text>
      <text x="520" y="116" text-anchor="middle" font-size="9" fill="#bee3f8">46 pay grades</text>

      <!-- Tools -->
      <rect x="620" y="80" width="220" height="48" rx="4" fill="white" stroke="#3182ce" stroke-width="1"/>
      <text x="730" y="100" text-anchor="middle" font-size="10" font-weight="600" fill="#2a4365">Tools: requests, BeautifulSoup,</text>
      <text x="730" y="116" text-anchor="middle" font-size="10" fill="#4a5568">regex, pdfplumber, pandas</text>

      <!-- === LAYER 2: Structured Data === -->
      <rect x="20" y="155" width="840" height="80" rx="6" fill="#f0fff4" stroke="#276749" stroke-width="1" stroke-dasharray="4"/>
      <text x="40" y="175" font-size="11" font-weight="700" fill="#22543d">LAYER 2: Structured Reference Data (SQLite + Excel)</text>

      <!-- Tables -->
      <rect x="40" y="185" width="100" height="38" rx="4" fill="#276749"/>
      <text x="90" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">career_groups</text>
      <text x="90" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">56 rows</text>

      <rect x="155" y="185" width="80" height="38" rx="4" fill="#276749"/>
      <text x="195" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">roles</text>
      <text x="195" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">294 rows</text>

      <rect x="250" y="185" width="90" height="38" rx="4" fill="#276749"/>
      <text x="295" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">soc_codes</text>
      <text x="295" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">666 rows</text>

      <rect x="355" y="185" width="110" height="38" rx="4" fill="#276749"/>
      <text x="410" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">historical_titles</text>
      <text x="410" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">1,469 rows</text>

      <rect x="480" y="185" width="110" height="38" rx="4" fill="#276749"/>
      <text x="535" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">dhrm_pay_bands</text>
      <text x="535" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">9 rows</text>

      <rect x="605" y="185" width="110" height="38" rx="4" fill="#276749"/>
      <text x="660" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">wm_pay_grades</text>
      <text x="660" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">46 rows</text>

      <rect x="730" y="185" width="110" height="38" rx="4" fill="#276749"/>
      <text x="785" y="200" text-anchor="middle" font-size="9" font-weight="600" fill="white">crosswalk</text>
      <text x="785" y="214" text-anchor="middle" font-size="8" fill="#c6f6d5">9 rows</text>

      <!-- === LAYER 3: Classification === -->
      <rect x="20" y="250" width="840" height="155" rx="6" fill="#faf5ff" stroke="#6b46c1" stroke-width="1" stroke-dasharray="4"/>
      <text x="40" y="270" font-size="11" font-weight="700" fill="#44337a">LAYER 3: Classification (Current -- Prompt Only)</text>

      <!-- Input: Position Description -->
      <rect x="40" y="285" width="160" height="50" rx="4" fill="#e9d8fd" stroke="#6b46c1" stroke-width="1.5"/>
      <text x="120" y="305" text-anchor="middle" font-size="10" font-weight="700" fill="#44337a">Position Description</text>
      <text x="120" y="320" text-anchor="middle" font-size="9" fill="#553c9a">(HR pastes PD text)</text>

      <!-- Arrow -->
      <line x1="200" y1="310" x2="240" y2="310" stroke="#6b46c1" stroke-width="2" marker-end="url(#arrowPurple)"/>
      <defs><marker id="arrowPurple" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><path d="M0,0 L8,3 L0,6" fill="#6b46c1"/></marker></defs>

      <!-- Prompt Template -->
      <rect x="245" y="280" width="140" height="60" rx="4" fill="#6b46c1"/>
      <text x="315" y="300" text-anchor="middle" font-size="10" font-weight="600" fill="white">Prompt Template</text>
