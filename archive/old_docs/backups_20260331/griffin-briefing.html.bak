      <!-- LLM -->
      <rect x="430" y="280" width="120" height="60" rx="25" fill="#44337a"/>
      <text x="490" y="306" text-anchor="middle" font-size="12" font-weight="700" fill="white">LLM</text>
      <text x="490" y="322" text-anchor="middle" font-size="9" fill="#d6bcfa">Any provider</text>

      <!-- Arrow -->
