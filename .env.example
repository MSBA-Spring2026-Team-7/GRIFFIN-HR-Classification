# GRIFFIN HR Classification — Local development environment
# Copy this file to .env and fill in your actual keys.
# .env is gitignored — never commit real keys.

# Required: Google Gemini API key
# Get from https://aistudio.google.com/app/apikey
# Either variable name is accepted by the app; GEMINI_API_KEY is canonical.
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: CareerOneStop (salary data enrichment; not required for core flow)
CAREERONESTOP_TOKEN=
CAREERONESTOP_USER_ID=

# Optional: GCP Cloud SQL — leave blank to use local SQLite fallback
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=3306
CLOUD_SQL_DB=griffin_db
CLOUD_SQL_USER=root
CLOUD_SQL_PASSWORD=
