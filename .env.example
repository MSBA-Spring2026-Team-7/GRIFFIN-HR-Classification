# GRIFFIN API Keys — NEVER commit this file to git
# Copy this file to .env and fill in your actual keys.

GOOGLE_API_KEY=your-google-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
CAREERONESTOP_TOKEN=your-careeronestop-token-here
CAREERONESTOP_USER_ID=your-careeronestop-user-id-here

# GCP Cloud SQL — leave blank to use local SQLite fallback
CLOUD_SQL_HOST=
CLOUD_SQL_PORT=3306
CLOUD_SQL_DB=griffin_db
CLOUD_SQL_USER=root
CLOUD_SQL_PASSWORD=
